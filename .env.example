# Copie ce fichier en .env et remplis les valeurs

# Formspree — https://formspree.io (formulaire contact → email)
VITE_FORMSPREE_ID=

# WhatsApp (indicatif pays + numéro, sans + ni espaces) ex: 213550123456
VITE_WHATSAPP=213550123456

# Google Analytics 4 (optionnel) ex: G-XXXXXXXXXX
VITE_GA_ID=

# URL publique du site (SEO)
VITE_SITE_URL=https://praxisagency.dz
